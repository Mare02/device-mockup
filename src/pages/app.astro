---
import Layout from '../layouts/Layout.astro';
import { DeviceMockup } from '../components/DeviceMockup';
import '../styles/global.css';
import { MonitorSmartphone } from 'lucide-react';

const title = "App Master — Device Mockup Editor";
const description = "The interactive editor for creating professional app screenshots and mockups.";
---

<Layout title={title} description={description}>
	<div class="min-h-screen bg-zinc-950">
		<header class="h-16 border-b border-white/5 flex items-center justify-between px-6 bg-black/50 backdrop-blur-md sticky top-0 z-50">
			<a href="/" class="flex items-center gap-2 group transition-opacity hover:opacity-80">
				<div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-white shadow-[0_0_15px_rgba(99,102,241,0.3)]">
					<MonitorSmartphone size={16} />
				</div>
				<span class="text-xl font-bold font-outfit text-white tracking-tight">MockupMaster</span>
			</a>

			<nav class="flex items-center gap-6">
				<a href="/" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">Home</a>
			</nav>
		</header>

		<main class="py-8">
			<div class="max-w-[1600px] mx-auto px-4">
				<DeviceMockup client:only="react" />
			</div>
		</main>
	</div>
</Layout>
