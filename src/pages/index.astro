---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { MonitorSmartphone, Download, Sparkles, Layers, Share2 } from 'lucide-react';

const title = "MockupMaster — Professional App Screenshot Generator";
const description = "Create stunning, high-resolution device mockups and app store screenshots in seconds. Choose from multiple devices, gradients, and custom transforms.";
---

<Layout title={title} description={description}>
	<main class="min-h-screen">
		{/* Global Navbar */}
		<nav class="h-16 border-b border-white/5 flex items-center justify-between px-6 bg-black/50 backdrop-blur-md sticky top-0 z-50">
			<a href="/" class="flex items-center gap-2 group transition-opacity hover:opacity-80">
				<div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-white shadow-[0_0_15px_rgba(99,102,241,0.3)]">
					<MonitorSmartphone size={16} />
				</div>
				<span class="text-xl font-bold font-outfit text-white tracking-tight">MockupMaster</span>
			</a>

			<nav class="flex items-center gap-6">
				<a href="/" class="text-sm font-medium text-white transition-colors">Home</a>
				<a href="/app" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors">Editor</a>
			</nav>
		</nav>

		{/* Hero Section */}
		<header class="relative pt-16 pb-16 px-4 overflow-hidden">
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-gradient-to-b from-primary/20 via-transparent to-transparent -z-10 blur-3xl opacity-50"></div>
			<div class="absolute -top-24 -left-24 w-96 h-96 bg-primary/30 rounded-full blur-[120px] -z-10 animate-float"></div>
			<div class="absolute top-1/2 -right-24 w-96 h-96 bg-indigo-500/20 rounded-full blur-[120px] -z-10 animate-float" style="animation-delay: -2s;"></div>
			
			<div class="container mx-auto text-center">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-medium mb-8 animate-fade-in">
					<Sparkles size={14} />
					<span>The ultimate mockup tool for developers</span>
				</div>
				
				<h1 class="text-5xl md:text-7xl font-extrabold pb-2 gradient-text font-outfit tracking-tight mb-6">
					Professional mockups <br /> and screenshots simplified.
				</h1>
				
				<p class="text-zinc-400 text-lg md:text-xl max-w-2xl mx-auto mb-10 text-balance">
					Create stunning, high-resolution app screenshots in seconds. Choose from multiple devices, custom backgrounds, and advanced transformation tools.
				</p>
				
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
					<a href="/app" class="px-8 py-4 rounded-full bg-primary text-primary-foreground font-bold hover:shadow-[0_0_30px_rgba(99,102,241,0.4)] transition-all flex items-center gap-2 group">
						<span>Launch Editor</span>
						<Share2 size={18} class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
					</a>
					<a href="#features" class="px-8 py-4 rounded-full bg-white/5 border border-white/10 text-white font-bold hover:bg-white/10 transition-all">
						Learn More
					</a>
				</div>
			</div>
		</header>

		{/* Showcase Section */}
		<section id="features" class="relative pb-32">
			<div class="container mx-auto px-4">
				<div class="relative max-w-5xl mx-auto rounded-3xl border border-white/10 bg-zinc-900/50 p-4 shadow-2xl backdrop-blur-sm overflow-hidden group">
					<div class="absolute inset-0 bg-gradient-to-tr from-primary/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
					<div class="aspect-video rounded-2xl bg-zinc-950 flex flex-col items-center justify-center border border-white/5 relative overflow-hidden">
						<MonitorSmartphone size={80} class="text-primary/20 mb-6 animate-float" />
						<div class="text-center px-4">
							<h3 class="text-2xl font-bold mb-2">Interactive Preview</h3>
							<p class="text-zinc-500 max-w-md mx-auto">Our powerful editor gives you full control over every pixel. Launch the app to start designing your screenshots.</p>
						</div>
						<div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-zinc-950 to-transparent flex items-end justify-center pb-12">
							<a href="/app" class="px-6 py-3 rounded-xl bg-white text-black font-bold flex items-center gap-2 hover:scale-105 transition-transform shadow-lg">
								Try it now for free
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* Features Section */}
		<section class="py-24 bg-zinc-900/40 border-y border-white/5">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					<div class="flex flex-col gap-4">
						<div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
							<MonitorSmartphone size={24} />
						</div>
						<h3 class="text-xl font-bold font-outfit">Multiple Devices</h3>
						<p class="text-zinc-400">Choose from iPhone Notch Island, Classic Notch, Android Hole Cutout, and more for your mockups.</p>
					</div>
					
					<div class="flex flex-col gap-4">
						<div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
							<Layers size={24} />
						</div>
						<h3 class="text-xl font-bold font-outfit">Custom Backgrounds</h3>
						<p class="text-zinc-400">Add beautiful gradients or solid colors behind your device mockups with a single click.</p>
					</div>
					
					<div class="flex flex-col gap-4">
						<div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
							<Download size={24} />
						</div>
						<h3 class="text-xl font-bold font-outfit">High-Res Export</h3>
						<p class="text-zinc-400">Export your work in PNG or JPG formats with maximum quality, ready for App Store or social media.</p>
					</div>
				</div>
			</div>
		</section>

		{/* Footer */}
		<footer class="py-12 border-t border-white/5 bg-black">
			<div class="container mx-auto px-4 text-center">
				<div class="flex items-center justify-center gap-2 mb-6">
					<div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-white">
						<MonitorSmartphone size={16} />
					</div>
					<span class="text-xl font-bold font-outfit tracking-tight">MockupMaster</span>
				</div>
				<p class="text-zinc-500 text-sm">© 2026 MockupMaster. Powered by Astro & React.</p>
			</div>
		</footer>
	</main>
</Layout>

<style>
	@keyframes fade-in {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fade-in 0.8s ease-out forwards;
	}
</style>
